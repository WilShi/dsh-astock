{
  "name": "dsh-astock",
  "version": "0.1.0",
  "type": "module",
  "description": "A 股研究台：给 DeepSeek Harness 装上行情、财报、估值与研报生成能力，零配置、免 API Key。A-share research tools for DSH.",
  "license": "MIT",
  "author": "WilShi",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "a-share",
    "stock",
    "investment",
    "research",
    "valuation",
    "finance"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit",
    "smoke": "node --experimental-strip-types --no-warnings scripts/smoke.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4 <5",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@types/node": "^22.10.0",
    "tsdown": "^0.13.0",
    "typescript": "^5.9.0"
  }
}
